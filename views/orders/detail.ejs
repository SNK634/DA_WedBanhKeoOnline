<%- include('../partials/header') %>

<section class="page-hero compact-hero orders-hero"><div class="container"><span class="page-hero-icon">🧾</span><span class="section-kicker">Mã đơn #<%= order._id %></span><h1>Chi tiết đơn hàng</h1></div></section>

<section class="section order-detail-section">
    <div class="container order-detail-layout">
        <div class="order-detail-main">
            <% if (order.isDemo) { %><div class="alert demo-checkout-notice">Đây là đơn mô phỏng, không được ghi vào MongoDB và không phát sinh giao dịch thật.</div><% } %>
            <section class="checkout-card">
                <div class="checkout-card-heading"><span>🍬</span><div><small>Sản phẩm</small><h2>Danh sách món</h2></div></div>
                <div class="detail-order-items">
                    <% order.items.forEach((item) => { %><div><span><%= item.image %></span><p><strong><%= item.name %></strong><small><%= item.quantity %> × <%= item.price.toLocaleString('vi-VN') %>đ</small></p><strong><%= item.subtotal.toLocaleString('vi-VN') %>đ</strong></div><% }) %>
                </div>
            </section>
            <section class="checkout-card recipient-card">
                <div class="checkout-card-heading"><span>🏠</span><div><small>Giao tới</small><h2>Thông tin người nhận</h2></div></div>
                <p><strong><%= order.customerInfo.fullName %></strong> · <%= order.customerInfo.phone %></p>
                <p><%= order.customerInfo.address %>, <%= order.customerInfo.ward %>, <%= order.customerInfo.district %>, <%= order.customerInfo.city %></p>
                <p><%= order.customerInfo.email %></p>
                <% if (order.customerInfo.note) { %><p class="order-note">Ghi chú: <%= order.customerInfo.note %></p><% } %>
            </section>
        </div>
        <aside class="checkout-summary order-status-summary">
            <h2>Trạng thái đơn</h2>
            <span class="status-pill"><%= orderStatusLabels[order.orderStatus] %></span>
            <dl><div><dt>Ngày đặt</dt><dd><%= new Date(order.createdAt).toLocaleString('vi-VN') %></dd></div><div><dt>Thanh toán</dt><dd><%= paymentLabels[order.paymentMethod] %></dd></div><div><dt>Trạng thái tiền</dt><dd><%= paymentStatusLabels[order.paymentStatus] %></dd></div></dl>
            <div class="checkout-totals"><div><span>Tạm tính</span><strong><%= order.subtotal.toLocaleString('vi-VN') %>đ</strong></div><div><span>Vận chuyển</span><strong><%= order.shippingFee ? `${order.shippingFee.toLocaleString('vi-VN')}đ` : 'Miễn phí' %></strong></div><div class="grand-total"><span>Tổng cộng</span><strong><%= order.totalAmount.toLocaleString('vi-VN') %>đ</strong></div></div>
            <a class="btn btn-primary place-order-button" href="/products">Tiếp tục mua sắm</a>
        </aside>
    </div>
</section>

<%- include('../partials/footer') %>
