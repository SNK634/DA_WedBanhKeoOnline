<%- include('../partials/header') %>

<section class="auth-section">
    <div class="spider-web spider-web-form" aria-hidden="true"></div>
    <div class="auth-card">
        <div class="auth-icon" aria-hidden="true">👻</div>
        <span class="section-kicker">Chào mừng trở lại</span>
        <h1>Đăng nhập SweetShop</h1>
        <p class="auth-intro">Đăng nhập để tiếp tục hành trình săn kẹo Halloween của bạn.</p>

        <% if (notice) { %>
            <div class="alert alert-notice" role="status"><%= notice %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-error" role="alert"><%= error %></div>
        <% } %>

        <form class="auth-form" action="/login" method="post">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value="<%= formData.email %>" autocomplete="email" placeholder="ban@example.com" required>

            <label for="password">Mật khẩu</label>
            <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required>

            <button class="btn btn-primary form-submit" type="submit">Đăng nhập</button>
        </form>

        <p class="auth-switch">Chưa có tài khoản? <a href="/register">Đăng ký ngay</a></p>
    </div>
</section>

<%- include('../partials/footer') %>
